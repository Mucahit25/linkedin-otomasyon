# Yerel deneme için anahtar şablonu. Bu dosyayı ".env" adıyla kopyala ve değerleri doldur.
# ".env" asla GitHub'a yüklenmez. Bulutta bu değerler GitHub Secrets içinde durur.
# Antigravity içinde çalışırken _knowledge/credentials/master.env de otomatik okunur.

# Buffer > Ayarlar > API (publish.buffer.com/settings/api)
BUFFER_API_KEY=

# Açıklama motoru "claude_abonelik" ise (varsayılan): bulutta Claude aboneliği için
# "claude setup-token" komutuyla alınan kod. Yerelde gerekmez, bilgisayardaki giriş kullanılır.
CLAUDE_CODE_OAUTH_TOKEN=

# Sadece açıklama motoru "api" ise: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Bildirim e-postası (Gmail, uygulama şifresiyle)
GMAIL_ADRES=
GMAIL_UYGULAMA_SIFRESI=
BILDIRIM_EPOSTA=

# İsteğe bağlı: WhatsApp bildirimi (CallMeBot)
WHATSAPP_TELEFON=
WHATSAPP_APIKEY=

# İsteğe bağlı: Buffer'da birden fazla LinkedIn hesabı varsa hangisi
BUFFER_LINKEDIN_KANAL_ID=
